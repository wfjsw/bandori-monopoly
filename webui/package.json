{
  "name": "bandori-monopoly-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../tools/build-glue.mjs",
    "dev": "rsbuild dev",
    "prebuild": "node -e \"fs.existsSync('../tools/live2d/build.mjs') && child_process.execFileSync(process.execPath, ['../tools/live2d/build.mjs'], { stdio: 'inherit' })\" && node ../tools/build-glue.mjs",
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
    "test:console": "node --test src/console/*.test.ts",
    "preview": "rsbuild preview"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  }
}
